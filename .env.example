# Пример переменных окружения. Реальные значения задавайте в панели хостинга (Render) или локально
# в .env / настройках запуска IDE — сам файл с секретами в git не кладите.

# --- База данных ---
DATABASE_URL=jdbc:postgresql://localhost:5432/massage_salon
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

# --- Безопасность (обязательно) ---
# Секрет подписи токенов входа, минимум 32 байта: openssl rand -base64 32
JWT_SECRET=
# Аккаунт руководителя. Если OWNER_PASSWORD пуст, а аккаунта ещё нет — пароль сгенерируется
# и один раз появится в логе запуска. Заданный здесь пароль применяется при каждом старте.
OWNER_EMAIL=admin@salon.ru
OWNER_PASSWORD=

# --- Сайты, которым разрешён доступ к API (через запятую) ---
CORS_ALLOWED_ORIGINS=https://em-del.kz,https://www.em-del.kz

# --- Telegram (необязательно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_IDS=

# --- Фронтенд (задаётся в Vercel) ---
# VITE_API_URL=https://api.em-del.kz
